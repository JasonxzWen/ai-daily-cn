{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily-codex-dag.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "resilience_policy_path", "nodes"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "const": "daily-codex-dag-contract" },
    "description": { "type": "string", "minLength": 1 },
    "resilience_policy_path": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "execution_status",
        "execution_contract",
        "dependencies",
        "inputs",
        "outputs",
        "schemas",
        "fixture",
        "parallel_group",
        "runner_stage_ref",
        "resilience_policy_ref",
        "failure_policy",
        "public_artifact",
        "owner_path_scope"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z0-9-]+)?$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["command", "codex_exec", "fanout", "barrier"] },
        "execution_status": { "enum": ["planned", "mapped"] },
        "execution_contract": { "$ref": "#/$defs/executionContract" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output"],
          "properties": {
            "input": { "type": "string", "minLength": 1 },
            "output": { "type": "string", "minLength": 1 }
          }
        },
        "fixture": { "type": "string", "minLength": 1 },
        "parallel_group": { "type": "string" },
        "runner_stage_ref": { "type": "string" },
        "resilience_policy_ref": { "type": "string" },
        "failure_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "summary"],
          "properties": {
            "mode": { "enum": ["planned", "resilience_policy_ref"] },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "public_artifact": { "type": "boolean" },
        "owner_path_scope": { "enum": ["internal_workdir", "docs", "reports_data", "none"] },
        "fanout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "item_id_field"],
          "properties": {
            "from": { "type": "string", "minLength": 1 },
            "item_id_field": { "type": "string", "minLength": 1 }
          }
        },
        "barrier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wait_for"],
          "properties": {
            "wait_for": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "executionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "summary"],
      "properties": {
        "readiness": { "enum": ["planned_only", "legacy_mapped", "node_executable"] },
        "summary": { "type": "string", "minLength": 1 },
        "node_execution_spec": { "$ref": "#/$defs/nodeExecutionSpec" }
      }
    },
    "nodeExecutionSpec": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "executor": { "const": "command" } },
            "required": ["executor"]
          },
          "then": {
            "properties": {
              "invocation": { "$ref": "#/$defs/commandInvocation" }
            }
          }
        },
        {
          "if": {
            "properties": { "executor": { "const": "codex_cli" } },
            "required": ["executor"]
          },
          "then": {
            "properties": {
              "invocation": { "$ref": "#/$defs/codexCliInvocation" }
            }
          }
        }
      ],
      "required": [
        "executor",
        "cwd",
        "invocation",
        "inputs",
        "outputs",
        "timeout_seconds",
        "retry_policy",
        "concurrency_group",
        "sandbox",
        "artifact_verification",
        "idempotency_key",
        "resume_policy",
        "publish_boundary"
      ],
      "properties": {
        "executor": { "enum": ["command", "codex_cli"] },
        "cwd": { "type": "string", "minLength": 1 },
        "invocation": {
          "oneOf": [
            { "$ref": "#/$defs/commandInvocation" },
            { "$ref": "#/$defs/codexCliInvocation" }
          ]
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactBinding" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactBinding" }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "retry_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts", "backoff_seconds"],
          "properties": {
            "max_attempts": { "type": "integer", "minimum": 1 },
            "backoff_seconds": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "concurrency_group": { "type": "string", "minLength": 1 },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filesystem", "network", "secrets"],
          "properties": {
            "filesystem": { "enum": ["read_only", "workspace_write", "public_artifact_write"] },
            "network": { "enum": ["disabled", "source_allowlist", "enabled"] },
            "secrets": { "enum": ["none", "runtime_scoped"] }
          }
        },
        "artifact_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "existence", "privacy_scan"],
          "properties": {
            "schema": { "enum": ["declared_outputs", "none"] },
            "existence": { "enum": ["required_outputs", "none"] },
            "privacy_scan": { "enum": ["public_outputs", "none"] }
          }
        },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "resume_policy": { "enum": ["rerun", "reuse_valid_outputs", "manual_only"] },
        "publish_boundary": { "enum": ["none", "internal_only", "public_artifacts"] }
      }
    },
    "commandInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "argv"],
      "properties": {
        "kind": { "const": "command" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "codexCliInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prompt_template", "args"],
      "properties": {
        "kind": { "const": "codex_cli" },
        "prompt_template": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path"],
      "properties": {
        "artifact_path": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "required"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "plannedNodeInput": {
      "type": "object",
      "additionalProperties": true
    },
    "plannedNodeOutput": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
