{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/home.schema.json",
  "title": "AI Daily Homepage Edition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_title",
    "generated_at",
    "latest_edition",
    "previous_edition",
    "source_watch",
    "archive",
    "byte_size"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "site_title": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "latest_edition": {
      "oneOf": [
        { "$ref": "#/$defs/edition" },
        { "type": "null" }
      ]
    },
    "previous_edition": {
      "oneOf": [
        { "$ref": "#/$defs/edition" },
        { "type": "null" }
      ]
    },
    "source_watch": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/source_watch_item" }
    },
    "archive": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/archive_entry" }
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 131072
    }
  },
  "$defs": {
    "relative_url": {
      "type": "string",
      "pattern": "^(?!/)(?![a-zA-Z][a-zA-Z0-9+.-]*:).+"
    },
    "tags": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "summary",
        "event_date",
        "source",
        "label",
        "tags",
        "report_url"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 8, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "summary": { "type": "string", "minLength": 1 },
        "event_date": { "type": "string", "format": "date" },
        "source": { "type": "string", "minLength": 1 },
        "label": { "const": "本期主线" },
        "tags": { "$ref": "#/$defs/tags" },
        "report_url": { "$ref": "#/$defs/relative_url" }
      }
    },
    "source_watch_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "summary", "event_date", "source", "label", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 8, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "summary": { "type": "string", "minLength": 1 },
        "event_date": { "type": "string", "format": "date" },
        "source": { "type": "string", "minLength": 1 },
        "label": { "const": "Source Watch" },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_date",
        "title",
        "summary",
        "report_url",
        "data_url",
        "generated_at",
        "story_count",
        "lead_story",
        "secondary_stories",
        "compact_stories"
      ],
      "properties": {
        "report_date": { "type": "string", "format": "date" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "report_url": { "$ref": "#/$defs/relative_url" },
        "data_url": { "$ref": "#/$defs/relative_url" },
        "generated_at": { "type": "string", "format": "date-time" },
        "story_count": { "type": "integer", "minimum": 0, "maximum": 18 },
        "lead_story": {
          "oneOf": [
            { "$ref": "#/$defs/story" },
            { "type": "null" }
          ]
        },
        "secondary_stories": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/story" }
        },
        "compact_stories": {
          "type": "array",
          "maxItems": 14,
          "items": { "$ref": "#/$defs/story" }
        }
      }
    },
    "archive_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_date", "title", "summary", "url"],
      "properties": {
        "report_date": { "type": "string", "format": "date" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/relative_url" }
      }
    }
  }
}
