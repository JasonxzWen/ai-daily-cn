{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/frontend-runtime.schema.json",
  "title": "ADC React Runtime Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "build_id",
    "mode",
    "report_date",
    "final_status",
    "artifacts",
    "source_inputs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "build_id": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
    "mode": { "const": "static-react-github-pages" },
    "report_date": { "type": "string", "format": "date" },
    "final_status": { "enum": ["ready", "degraded"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "source_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_input" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "count", "hash"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^data/[a-z0-9-]+\\.json$"
        },
        "count": { "type": "integer", "minimum": 0 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{12}$" }
      }
    },
    "source_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "status", "article_count"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "status": { "enum": ["checked", "blocked", "not_configured_or_skipped"] },
        "article_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
