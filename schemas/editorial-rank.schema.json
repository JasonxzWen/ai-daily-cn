{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/editorial-rank.schema.json",
  "title": "Internal Editorial Rank Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "generated_at",
    "source_window",
    "items"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "source_window": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "date": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "relative_hours": { "type": "integer", "minimum": 1 }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/rankedItem" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "admissionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "selected", "blocking_demotion_reasons"],
      "properties": {
        "eligible": { "type": "boolean" },
        "selected": { "type": "boolean" },
        "blocking_demotion_reasons": { "$ref": "#/$defs/stringArray" }
      }
    },
    "rankedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "editorial_rank",
        "score",
        "rank_policy",
        "selection_reasons",
        "demotion_reasons",
        "lane_ids",
        "topic_ids",
        "entity_ids",
        "event_type",
        "verification_status",
        "admission"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "editorial_rank": { "type": "integer", "minimum": 1, "maximum": 100 },
        "score": { "type": "number" },
        "rank_policy": { "type": "string", "minLength": 1 },
        "selection_reasons": { "$ref": "#/$defs/stringArray" },
        "demotion_reasons": { "$ref": "#/$defs/stringArray" },
        "lane_ids": { "$ref": "#/$defs/nonEmptyStringArray" },
        "topic_ids": { "$ref": "#/$defs/stringArray" },
        "entity_ids": { "$ref": "#/$defs/stringArray" },
        "event_type": { "type": "string", "minLength": 1 },
        "verification_status": { "type": "string", "minLength": 1 },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["today_selected", "must_read"],
          "properties": {
            "today_selected": { "$ref": "#/$defs/admissionTarget" },
            "must_read": { "$ref": "#/$defs/admissionTarget" }
          }
        }
      }
    }
  }
}
