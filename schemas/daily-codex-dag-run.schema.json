{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/daily-codex-dag-run.schema.json",
  "title": "Daily Codex DAG Run Summary",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/contract_run_success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "failures",
        "warnings",
        "validation",
        "mode",
        "report_date",
        "generated_at",
        "plan",
        "run",
        "next_action"
      ],
      "properties": {
        "ok": { "const": true },
        "failures": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "warnings": { "$ref": "#/$defs/messages" },
        "validation": { "$ref": "#/$defs/success_validation" },
        "mode": { "const": "daily_codex_dag_dry_run" },
        "report_date": { "type": "string", "format": "date" },
        "generated_at": { "type": "string", "format": "date-time" },
        "plan": { "$ref": "#/$defs/plan" },
        "run": { "$ref": "#/$defs/run" },
        "next_action": { "$ref": "#/$defs/next_action" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "failures", "warnings", "validation", "plan", "run"],
      "properties": {
        "ok": { "const": false },
        "failures": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "warnings": { "$ref": "#/$defs/messages" },
        "validation": {
          "anyOf": [
            { "$ref": "#/$defs/validation" },
            { "type": "null" }
          ]
        },
        "plan": { "type": "null" },
        "run": { "type": "null" }
      }
    },
    "contract_run_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "failures",
        "warnings",
        "validation",
        "mode",
        "report_date",
        "generated_at",
        "run_id",
        "plan",
        "run",
        "node_results",
        "node_result_validation",
        "fanout_expansions",
        "executed_commands",
        "codex_invocations",
        "next_action"
      ],
      "properties": {
        "ok": { "const": true },
        "failures": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "warnings": { "$ref": "#/$defs/messages" },
        "validation": { "$ref": "#/$defs/success_validation" },
        "mode": { "const": "daily_codex_dag_contract_run" },
        "report_date": { "type": "string", "format": "date" },
        "generated_at": { "type": "string", "format": "date-time" },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "plan": { "$ref": "#/$defs/plan" },
        "run": { "$ref": "#/$defs/contract_run" },
        "node_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_result" }
        },
        "node_result_validation": { "$ref": "#/$defs/node_result_validation" },
        "fanout_expansions": {
          "type": "array",
          "items": { "$ref": "#/$defs/fanout_expansion" }
        },
        "executed_commands": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "object" }
        },
        "codex_invocations": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "object" }
        },
        "next_action": { "$ref": "#/$defs/next_action" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "failures", "warnings", "node_ids", "checked_files"],
      "properties": {
        "ok": { "type": "boolean" },
        "failures": { "$ref": "#/$defs/messages" },
        "warnings": { "$ref": "#/$defs/messages" },
        "node_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        },
        "checked_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "success_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "failures", "warnings", "node_ids", "checked_files"],
      "properties": {
        "ok": { "const": true },
        "failures": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "warnings": { "$ref": "#/$defs/messages" },
        "node_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        },
        "checked_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest_name", "description", "node_count", "levels", "nodes"],
      "properties": {
        "schema_version": { "const": 1 },
        "manifest_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "node_count": { "type": "integer", "minimum": 0 },
        "levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/level" }
        },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/plan_node" }
        }
      }
    },
    "plan_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "execution_status",
        "execution_contract",
        "plan_status",
        "level",
        "dependencies",
        "inputs",
        "outputs",
        "runner_stage_ref",
        "parallel_group",
        "public_artifact",
        "owner_path_scope"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/node_id" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["command", "codex_exec", "fanout", "barrier"] },
        "execution_status": { "enum": ["planned", "mapped"] },
        "execution_contract": { "$ref": "#/$defs/execution_contract" },
        "plan_status": { "enum": ["planned", "mapped"] },
        "level": { "type": "integer", "minimum": 0 },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "runner_stage_ref": { "type": "string" },
        "parallel_group": { "type": "string" },
        "public_artifact": { "type": "boolean" },
        "owner_path_scope": { "enum": ["internal_workdir", "docs", "reports_data", "none"] }
      }
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "summary"],
      "properties": {
        "readiness": { "enum": ["planned_only", "legacy_mapped", "node_executable"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_status", "levels", "planned_nodes", "completed_nodes", "blocked_nodes"],
      "properties": {
        "final_status": { "const": "dry_run_only" },
        "levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/level" }
        },
        "planned_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        },
        "completed_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        },
        "blocked_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        }
      }
    },
    "contract_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_status",
        "levels",
        "planned_nodes",
        "contract_validated_nodes",
        "skipped_nodes",
        "blocked_nodes"
      ],
      "properties": {
        "final_status": { "const": "contract_validated_only" },
        "levels": {
          "type": "array",
          "items": { "$ref": "#/$defs/level" }
        },
        "planned_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        },
        "contract_validated_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        },
        "skipped_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        },
        "blocked_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "node_ids"],
      "properties": {
        "level": { "type": "integer", "minimum": 0 },
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node_id" },
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "required"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": { "const": "implement_executable_node_runner" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "node_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "report_date",
        "run_id",
        "manifest_name",
        "manifest_schema_version",
        "node_id",
        "node_kind",
        "runner_stage_ref",
        "result_scope",
        "execution_id",
        "status",
        "downstream_disposition",
        "started_at",
        "finished_at",
        "duration_ms",
        "attempts_started",
        "max_attempts",
        "attempts_exhausted",
        "dependency_results",
        "declared_inputs",
        "declared_outputs",
        "resolved_inputs",
        "resolved_outputs",
        "fanout",
        "barrier",
        "failures",
        "warnings",
        "audit"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "mode": { "const": "daily_codex_dag_node_result" },
        "report_date": { "type": "string", "format": "date" },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "manifest_name": { "const": "daily-codex-dag-contract" },
        "manifest_schema_version": { "const": 1 },
        "node_id": { "$ref": "#/$defs/node_id" },
        "node_kind": { "enum": ["command", "codex_exec", "fanout", "barrier"] },
        "runner_stage_ref": { "type": "string" },
        "result_scope": { "const": "node" },
        "execution_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "status": { "const": "skipped" },
        "downstream_disposition": { "const": "continue" },
        "started_at": { "type": "null" },
        "finished_at": { "type": "null" },
        "duration_ms": { "const": 0 },
        "attempts_started": { "const": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "attempts_exhausted": { "const": false },
        "dependency_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/contract_dependency_result" }
        },
        "declared_inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "declared_outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "resolved_inputs": {
          "type": "array",
          "maxItems": 0
        },
        "resolved_outputs": {
          "type": "array",
          "maxItems": 0
        },
        "fanout": { "type": "null" },
        "barrier": { "type": "null" },
        "failures": {
          "type": "array",
          "maxItems": 0
        },
        "warnings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node_result_issue" }
        },
        "audit": { "$ref": "#/$defs/node_result_audit" }
      }
    },
    "contract_dependency_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "execution_id", "status", "required", "downstream_disposition"],
      "properties": {
        "node_id": { "$ref": "#/$defs/node_id" },
        "execution_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "status": { "const": "skipped" },
        "required": { "const": true },
        "downstream_disposition": { "const": "continue" }
      }
    },
    "node_result_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "source", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "node_result_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parallel_group", "resilience_policy_ref", "owner_path_scope", "public_artifact", "validator_version"],
      "properties": {
        "parallel_group": { "type": "string" },
        "resilience_policy_ref": { "type": "string" },
        "owner_path_scope": { "enum": ["internal_workdir", "docs", "reports_data", "none"] },
        "public_artifact": { "type": "boolean" },
        "validator_version": { "const": "daily-codex-dag-node-result-v1" }
      }
    },
    "node_result_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "failures", "warnings", "checked_results", "validator_version"],
      "properties": {
        "ok": { "const": true },
        "failures": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "warnings": { "$ref": "#/$defs/messages" },
        "checked_results": { "type": "integer", "minimum": 0 },
        "validator_version": { "const": "daily-codex-dag-node-result-v1" }
      }
    },
    "fanout_expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "status", "item_count"],
      "properties": {
        "node_id": { "$ref": "#/$defs/node_id" },
        "kind": { "enum": ["fanout", "barrier"] },
        "status": { "const": "not_expanded" },
        "item_count": { "type": "null" }
      }
    },
    "messages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z0-9-]+)?$"
    }
  }
}
