        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "reader_relevance": {
          "type": "string",
          "minLength": 1
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        },
        "risk_note": {
          "type": "string",
          "minLength": 1
        },
        "watch_next": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "original_text": {
          "type": "string",
