{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/report.schema.json",
  "title": "AI Daily Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_date",
    "title",
    "summary",
    "canonical_url",
    "html_path",
    "source_window",
    "main_items",
    "projects",
    "builder_observations",
    "community_leads",
    "self_check",
    "publish_status",
    "generated_at"
  ],
  "allOf": [
    {
      "if": {
        "not": {
          "properties": {
            "report_status": {
              "const": "empty_due_to_network_outage"
            }
          },
          "required": ["report_status"]
        }
      },
      "then": {
        "properties": {
          "main_items": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "report_status": {
            "const": "empty_due_to_network_outage"
          }
        },
        "required": ["report_status"]
      },
      "then": {
        "properties": {
          "main_items": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_status": {
      "enum": ["normal", "empty_due_to_network_outage"]
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "hero_highlights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hero_highlight"
      },
      "default": []
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "markdown_path": {
      "$ref": "#/$defs/relative_path"
    },
    "html_path": {
      "$ref": "#/$defs/relative_path"
    },
    "source_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_from", "date_to", "fallback_window_used", "notes"],
      "properties": {
        "date_from": {
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "type": "string",
          "format": "date"
        },
        "fallback_window_used": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "source_audit": {
      "$ref": "#/$defs/source_audit"
    },
    "quality_status": {
      "$ref": "#/$defs/quality_status",
      "default": {
        "status": "ok",
        "reasons": [],
        "affected_sections": [],
        "degraded_sections": [],
        "blocking_issues": [],
        "public_note": "Core discovery checks completed without blocking degradation."
      }
    },
    "candidate_pool_path": {
      "$ref": "#/$defs/relative_path"
    },
    "github_trending": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/github_trending_item"
      },
      "default": []
    },
    "main_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/main_item"
      },
      "default": []
    },
    "model_releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model_release"
      },
      "default": []
    },
    "hot_blogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hot_blog"
      },
      "default": []
    },
    "daily_tracking": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/daily_tracking_item"
      },
      "default": []
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "default": []
    },
    "builder_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/builder_observation"
      },
      "default": []
    },
    "community_leads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/community_lead"
      },
      "default": []
    },
    "wechat_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform_exempt_item"
      }
    },
    "zhihu_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform_exempt_item"
      }
    },
    "reddit_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform_exempt_item"
      }
    },
    "evidence_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_asset"
      },
      "default": []
    },
    "self_check": {
      "$ref": "#/$defs/self_check"
    },
    "publish_status": {
      "$ref": "#/$defs/publish_status"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?![a-zA-Z][a-zA-Z0-9+.-]*:).+"
    },
    "absolute_url": {
      "type": "string",
      "format": "uri"
    },
    "non_negative_count_map": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "importance": {
      "enum": ["major", "notable", "general"]
    },
    "editorial_category": {
      "enum": [
        "headline",
        "ai_industry",
        "engineering_toolchain",
        "model_release",
        "company_business",
        "policy_infra",
        "content_aigc",
        "product_radar",
        "funding",
        "open_source",
        "viewpoint_analysis",
        "podcast",
        "x_discussion",
        "community_signal"
      ]
    },
    "source_level": {
      "enum": [
        "primary",
        "official",
        "paper",
        "github",
        "multi_source",
        "intermediary",
        "community",
        "original_social",
        "unverified",
        "wechat_primary_like",
        "wechat_industry_whitelist",
        "weekly_paper_aggregator",
        "open_source_aggregator",
        "tech_weekly_aggregator",
        "paper_api",
        "community_api",
        "paper_aggregator",
        "ai_news_aggregator",
        "aigc_content_industry",
        "ai_funding_product_radar",
        "official_company_news",
        "official_open_source_account",
        "official_model_host_account",
        "platform_exempt_signal"
      ]
    },
    "verification_status": {
      "enum": [
        "primary_confirmed",
        "multi_source_confirmed",
        "intermediary_only",
        "original_social_only",
        "unverified",
        "platform_exempt_unverified"
      ]
    },
    "quality_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons", "affected_sections", "public_note"],
      "properties": {
        "status": {
          "enum": ["ok", "degraded", "blocked"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "affected_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "degraded_sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality_issue"
          },
          "default": []
        },
        "blocking_issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality_issue"
          },
          "default": []
        },
        "public_note": {
          "type": "string"
        }
      }
    },
    "quality_issue": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "section", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "error_code": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string"
        }
      }
    },
    "evidence_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "source_url", "caption", "extraction_status"],
      "properties": {
        "type": {
          "enum": ["figure", "table"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "local_path": {
          "$ref": "#/$defs/relative_path"
        },
        "caption": {
          "type": "string"
        },
        "extraction_status": {
          "enum": ["source_image", "extracted_from_image", "manual_table", "unavailable"]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "asset_role": {
          "enum": ["content", "chart", "diagram", "table", "icon", "favicon", "logo", "avatar", "decorative"]
        },
        "capture_kind": {
          "enum": ["source_asset", "source_image", "page_screenshot", "browser_screenshot", "full_page_screenshot", "viewport_screenshot"]
        },
        "data": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "main_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "event_date",
        "url",
        "source",
        "tier",
        "entities",
        "summary",
        "bullets"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "editorial_category": {
          "$ref": "#/$defs/editorial_category"
        },
        "source_level": {
          "$ref": "#/$defs/source_level"
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "reader_relevance": {
          "type": "string",
          "minLength": 1
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        },
        "risk_note": {
          "type": "string",
          "minLength": 1
        },
        "image_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "image_urls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolute_url"
          },
          "default": []
        },
        "image_alt": {
          "type": "string",
          "minLength": 1
        },
        "image_source": {
          "type": "string",
          "minLength": 1
        },
        "watch_next": {
          "type": "string",
          "minLength": 1
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": ["T0", "T1", "T2", "T3"]
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "hero_highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "reason"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider",
        "availability",
        "event_date",
        "url",
        "source",
        "summary",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "editorial_category": {
          "$ref": "#/$defs/editorial_category"
        },
        "source_level": {
          "$ref": "#/$defs/source_level"
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "reader_relevance": {
          "type": "string",
          "minLength": 1
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        },
        "risk_note": {
          "type": "string",
          "minLength": 1
        },
        "image_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "image_urls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolute_url"
          },
          "default": []
        },
        "image_alt": {
          "type": "string",
          "minLength": 1
        },
        "image_source": {
          "type": "string",
          "minLength": 1
        },
        "watch_next": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "enum": ["open_weights", "closed_api", "closed_product", "research_preview"]
        },
        "release_scope": {
          "enum": ["provider_official_launch", "gateway_availability", "preview_access", "model_card_update"]
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "hot_blog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "publisher",
        "author",
        "event_date",
        "topic",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "editorial_category": {
          "$ref": "#/$defs/editorial_category"
        },
        "source_level": {
          "$ref": "#/$defs/source_level"
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "reader_relevance": {
          "type": "string",
          "minLength": 1
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        },
        "risk_note": {
          "type": "string",
          "minLength": 1
        },
        "image_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "image_urls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolute_url"
          },
          "default": []
        },
        "image_alt": {
          "type": "string",
          "minLength": 1
        },
        "image_source": {
          "type": "string",
          "minLength": 1
        },
        "watch_next": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "enum": ["blog", "interview", "podcast", "engineering_note"]
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "editorial_category": {
          "$ref": "#/$defs/editorial_category"
        },
        "source_level": {
          "$ref": "#/$defs/source_level"
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "reader_relevance": {
          "type": "string",
          "minLength": 1
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        },
        "risk_note": {
          "type": "string",
          "minLength": 1
        },
        "watch_next": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "use_case": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "signal": {
          "enum": ["release", "star_velocity", "trending", "notable_pr", "ecosystem", "official_update", "product_hunt"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "github_trending_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repo", "description", "url", "event_date", "source", "rank", "trend"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "editorial_category": {
          "$ref": "#/$defs/editorial_category"
        },
        "source_level": {
          "$ref": "#/$defs/source_level"
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "reader_relevance": {
          "type": "string",
          "minLength": 1
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        },
        "risk_note": {
          "type": "string",
          "minLength": 1
        },
        "watch_next": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "window": {
          "enum": ["daily", "weekly", "past_24_hours", ""]
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "previous_rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rank_delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "trend": {
          "enum": ["new", "up", "down", "same"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "builder_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "content", "url"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "editorial_category": {
