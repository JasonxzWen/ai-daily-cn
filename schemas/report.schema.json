{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/report.schema.json",
  "title": "AI Daily Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_date",
    "title",
    "summary",
    "canonical_url",
    "html_path",
    "source_window",
    "main_items",
    "projects",
    "builder_observations",
    "community_leads",
    "self_check",
    "publish_status",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "hero_highlights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hero_highlight"
      },
      "default": []
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "markdown_path": {
      "$ref": "#/$defs/relative_path"
    },
    "html_path": {
      "$ref": "#/$defs/relative_path"
    },
    "source_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_from", "date_to", "fallback_window_used", "notes"],
      "properties": {
        "date_from": {
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "type": "string",
          "format": "date"
        },
        "fallback_window_used": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "source_audit": {
      "$ref": "#/$defs/source_audit"
    },
    "quality_status": {
      "$ref": "#/$defs/quality_status",
      "default": {
        "status": "ok",
        "reasons": [],
        "affected_sections": [],
        "public_note": "Core discovery checks completed without blocking degradation."
      }
    },
    "candidate_pool_path": {
      "$ref": "#/$defs/relative_path"
    },
    "github_trending": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/github_trending_item"
      },
      "default": []
    },
    "main_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/main_item"
      },
      "default": []
    },
    "model_releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model_release"
      },
      "default": []
    },
    "hot_blogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hot_blog"
      },
      "default": []
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "default": []
    },
    "builder_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/builder_observation"
      },
      "default": []
    },
    "community_leads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/community_lead"
      },
      "default": []
    },
    "evidence_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_asset"
      },
      "default": []
    },
    "self_check": {
      "$ref": "#/$defs/self_check"
    },
    "publish_status": {
      "$ref": "#/$defs/publish_status"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?![a-zA-Z][a-zA-Z0-9+.-]*:).+"
    },
    "absolute_url": {
      "type": "string",
      "format": "uri"
    },
    "quality_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons", "affected_sections", "public_note"],
      "properties": {
        "status": {
          "enum": ["ok", "degraded", "blocked"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "affected_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "public_note": {
          "type": "string"
        }
      }
    },
    "evidence_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "source_url", "caption", "extraction_status"],
      "properties": {
        "type": {
          "enum": ["figure", "table"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "local_path": {
          "$ref": "#/$defs/relative_path"
        },
        "caption": {
          "type": "string"
        },
        "extraction_status": {
          "enum": ["source_image", "extracted_from_image", "manual_table", "unavailable"]
        },
        "data": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "main_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "event_date",
        "url",
        "source",
        "tier",
        "entities",
        "summary",
        "bullets"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": ["T0", "T1", "T2", "T3"]
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "hero_highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "reason"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider",
        "availability",
        "event_date",
        "url",
        "source",
        "summary",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "enum": ["open_weights", "closed_api", "closed_product", "research_preview"]
        },
        "release_scope": {
          "enum": ["provider_official_launch", "gateway_availability", "preview_access", "model_card_update"]
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "hot_blog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "publisher",
        "author",
        "event_date",
        "topic",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "enum": ["blog", "interview", "podcast", "engineering_note"]
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "use_case": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "signal": {
          "enum": ["release", "star_velocity", "trending", "notable_pr", "ecosystem", "official_update", "product_hunt"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "github_trending_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repo", "description", "url", "event_date", "source", "rank", "trend"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "window": {
          "enum": ["daily", "weekly", "past_24_hours", ""]
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "previous_rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rank_delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "trend": {
          "enum": ["new", "up", "down", "same"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "builder_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "content", "url"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "$ref": "#/$defs/candidate_id"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "community_lead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "url"],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        }
      }
    },
    "self_check": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "report_date",
        "main_items",
        "builder_observations",
        "builder_skill_used",
        "fallback_sources",
        "primary_links",
        "no_banned_words",
        "no_unsourced_numbers",
        "notes",
        "optimization_suggestions"
      ],
      "properties": {
        "report_date": {
          "type": "string",
          "format": "date"
        },
        "main_items": {
          "type": "integer",
          "minimum": 0
        },
        "builder_observations": {
          "type": "integer",
          "minimum": 0
        },
        "builder_skill_used": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "fallback_sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "primary_links": {
          "type": "boolean"
        },
        "no_banned_words": {
          "type": "boolean"
        },
        "no_unsourced_numbers": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "optimization_suggestions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "publish_status": {
          "$ref": "#/$defs/publish_status"
        }
      }
    },
    "source_audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github_trending": {
          "$ref": "#/$defs/source_audit_group"
        },
        "builder_sources": {
          "$ref": "#/$defs/source_audit_group"
        },
        "content_sources": {
          "$ref": "#/$defs/source_audit_group"
        },
        "search_sources": {
          "$ref": "#/$defs/source_audit_group"
        },
        "sources_health": {
          "$ref": "#/$defs/source_audit_group"
        }
      }
    },
    "source_audit_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "sources", "candidates_found", "included", "notes"],
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_audit_source"
          },
          "default": []
        },
        "candidates_found": {
          "type": "integer",
          "minimum": 0
        },
        "included": {
          "type": "integer",
          "minimum": 0
        },
        "shadow": {
          "type": "boolean"
        },
        "blocked_reason": {
          "type": "string"
        },
        "last_successful_feed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_runtime_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "provider_cost_units": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "source_audit_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "status"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "status": {
          "enum": ["checked", "blocked", "no_signal", "skipped_missing_token", "skipped_missing_base_url"]
        },
        "id": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "enablement": {
          "type": "string"
        },
        "verification_policy": {
          "type": "string"
        },
        "requires_original_url": {
          "type": "boolean"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "feed_like": {
          "type": "boolean"
        },
        "recent_48h_entries": {
          "type": "integer",
          "minimum": 0
        },
        "original_url_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "publish_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "html_generated",
        "repo_updated",
        "repo_pushed",
        "pages_url",
        "publish_error"
      ],
      "properties": {
        "html_generated": {
          "type": "boolean"
        },
        "repo_updated": {
          "type": "boolean"
        },
        "repo_pushed": {
          "type": "boolean"
        },
        "pages_url": {
          "type": "string",
          "anyOf": [
            {
              "format": "uri"
            },
            {
              "maxLength": 0
            }
          ]
        },
        "publish_error": {
          "type": "string"
        }
      }
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
