{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/sources.schema.json",
  "title": "AI Daily Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "absolute_url": {
      "type": "string",
      "format": "uri"
    },
    "source_level": {
      "enum": [
        "primary",
        "official",
        "paper",
        "github",
        "multi_source",
        "intermediary",
        "community",
        "original_social",
        "unverified",
        "wechat_primary_like",
        "wechat_industry_whitelist",
        "weekly_paper_aggregator",
        "open_source_aggregator",
        "tech_weekly_aggregator",
        "paper_api",
        "community_api",
        "paper_aggregator",
        "ai_news_aggregator",
        "aigc_content_industry",
        "ai_funding_product_radar",
        "official_company_news",
        "official_open_source_account",
        "official_model_host_account",
        "model_registry",
        "github_ai_news_directory",
        "weekly_ai_news_aggregator",
        "big_tech_company_watch",
        "china_big_tech_company_watch",
        "official_open_source_watch",
        "wechat2rss_medium_trust",
        "platform_exempt_signal"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "url",
        "source_kind",
        "candidate_category",
        "tier",
        "authority",
        "enablement",
        "verification_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "source_kind": {
          "enum": ["rss", "html_index", "rsshub", "rss_bridge", "aggregator", "search_api", "manual", "openrouter_rankings_public_playwright", "artificial_analysis_index_public_playwright", "swe_bench_pro_public_playwright", "github_report_markdown", "huggingface_daily_papers_api"]
        },
        "candidate_category": {
          "enum": [
            "main_item",
            "github_trending",
            "huggingface_trending",
            "model_release",
            "hot_blog",
            "project",
            "builder_observation",
            "community_lead",
            "wechat_item",
            "zhihu_item",
            "reddit_item"
          ]
        },
        "tier": {
          "enum": ["T0", "T1", "T2", "T3"]
        },
        "authority": {
          "enum": ["primary", "secondary", "intermediary", "aggregator", "community"]
        },
        "enablement": {
          "enum": ["core", "optional", "manual"]
        },
        "verification_policy": {
          "enum": ["primary_allowed", "primary_required", "multi_source_required", "community_only", "platform_signal_exempt"]
        },
        "source_level": {
          "$ref": "#/$defs/source_level"
        },
        "sourceLevel": {
          "$ref": "#/$defs/source_level"
        },
        "requires_original_url": {
          "type": "boolean"
        },
        "max_items_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "lookback_days": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000
        },
        "platform": {
          "enum": ["wechat", "zhihu", "reddit"]
        },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_url_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "include_keywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude_keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "public_disclosure_label": {
          "type": "string",
          "minLength": 1
        },
        "kill_switch": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_policy": {
                "const": "platform_signal_exempt"
              }
            },
            "required": ["verification_policy"]
          },
          "then": {
            "required": [
              "platform",
              "allowed_hosts",
              "include_keywords",
              "public_disclosure_label",
              "max_items_per_run",
              "kill_switch"
            ],
            "properties": {
              "source_kind": {
                "enum": ["rss", "html_index", "rsshub", "rss_bridge", "aggregator", "search_api"]
              },
              "candidate_category": {
                "enum": ["wechat_item", "zhihu_item", "reddit_item"]
              },
              "platform": {
                "enum": ["wechat", "zhihu", "reddit"]
              },
              "allowed_hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "include_keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "public_disclosure_label": {
                "type": "string",
                "minLength": 1
              },
              "max_items_per_run": {
                "type": "integer",
                "minimum": 1
              },
              "kill_switch": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    }
  }
}
