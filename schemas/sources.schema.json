{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/sources.schema.json",
  "title": "AI Daily Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "absolute_url": {
      "type": "string",
      "format": "uri"
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "url",
        "source_kind",
        "candidate_category",
        "source_group",
        "credibility_tag",
        "content_tags"
      ],
      "propertyNames": {
        "not": {
          "enum": ["tier", "authority", "enablement", "verification_policy", "source_level", "sourceLevel"]
        }
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "source_kind": {
          "enum": ["rss", "html_index", "rsshub", "rss_bridge", "aggregator", "search_api", "manual", "openrouter_rankings_public_playwright", "artificial_analysis_index_public_playwright", "swe_bench_pro_public_playwright", "github_report_markdown", "huggingface_daily_papers_api", "huggingface_hub_trending_api", "dated_changelog"]
        },
        "candidate_category": {
          "enum": [
            "main_item",
            "github_trending",
            "huggingface_trending",
            "model_release",
            "hot_blog",
            "project",
            "builder_observation",
            "community_lead",
            "wechat_item",
            "zhihu_item",
            "reddit_item"
          ]
        },
        "source_group": {
          "enum": ["official_blogs", "github_trending", "community_discussions", "x_updates", "news_newsletters", "papers_models", "other"]
        },
        "credibility_tag": {
          "enum": ["primary_material", "multi_source_material", "single_source_relay", "community_lead", "monitoring_lead", "pending_review"]
        },
        "content_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["model_release", "product_update", "open_source", "research", "engineering", "company_business", "funding", "policy_infrastructure", "industry_news", "creative_ai", "analysis_opinion", "podcast", "community_discussion", "other"]
          }
        },
        "requires_original_url": {
          "type": "boolean"
        },
        "fetch_page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_items_per_run": false,
        "maxItemsPerRun": false,
        "per_source_limit": false,
        "perSourceLimit": false,
        "lookback_days": false,
        "lookbackDays": false,
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000
        },
        "platform": {
          "enum": ["wechat", "zhihu", "reddit"]
        },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_url_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "include_keywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude_keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "public_disclosure_label": {
          "type": "string",
          "minLength": 1
        },
        "kill_switch": false,
        "killSwitch": false
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "candidate_category": {
                "enum": ["wechat_item", "zhihu_item", "reddit_item"]
              }
            },
            "required": ["candidate_category"]
          },
          "then": {
            "required": [
              "platform",
              "allowed_hosts",
              "include_keywords",
              "public_disclosure_label"
            ],
            "properties": {
              "source_kind": {
                "enum": ["rss", "html_index", "rsshub", "rss_bridge", "aggregator", "search_api"]
              },
              "candidate_category": {
                "enum": ["wechat_item", "zhihu_item", "reddit_item"]
              },
              "platform": {
                "enum": ["wechat", "zhihu", "reddit"]
              },
              "allowed_hosts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "include_keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "public_disclosure_label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
