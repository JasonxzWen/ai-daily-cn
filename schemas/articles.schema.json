{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/articles.schema.json",
  "title": "AI Daily Article Index",
  "type": "array",
  "items": {
    "$ref": "#/$defs/article"
  },
  "$defs": {
    "relative_url": {
      "type": "string",
      "pattern": "^(?!/)(?![a-zA-Z][a-zA-Z0-9+.-]*:).+"
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "summary",
        "date",
        "month",
        "source",
        "section",
        "quality_score",
        "importance",
        "domain",
        "flavors",
        "channels_l1",
        "channels_l2",
        "companies",
        "products"
      ],
      "allOf": [
        {
          "if": {
            "required": ["section"],
            "properties": {
              "section": { "const": "source_watch" }
            }
          },
          "then": {},
          "else": {
            "required": ["report_date", "report_url", "data_url"],
            "properties": {
              "report_date": {
                "type": "string",
                "format": "date"
              },
              "report_url": {
                "$ref": "#/$defs/relative_url"
              },
              "data_url": {
                "$ref": "#/$defs/relative_url"
              }
            }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "enum": [
            "stories",
            "main_items",
            "hot_blogs",
            "github_trending",
            "huggingface_trending",
            "daily_tracking",
            "projects",
            "builder_observations",
            "community_leads",
            "official_org_updates",
            "chinese_media_dynamics",
            "source_watch"
          ]
        },
        "report_date": {
          "type": "string",
          "format": "date"
        },
        "report_url": {
          "$ref": "#/$defs/relative_url"
        },
        "data_url": {
          "$ref": "#/$defs/relative_url"
        },
        "quality_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "importance": {
          "type": "string",
          "enum": ["major", "notable", "general"]
        },
        "domain": {
          "type": "string",
          "enum": [
            "AI 产品与应用工具",
            "AI 用法与实践方法",
            "企业落地与业务应用",
            "行业动态与政策地缘",
            "基础模型与算力技术栈",
            "多模态与具身等前沿"
          ]
        },
        "flavors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "快讯",
              "论文",
              "技术拆解",
              "商业洞察",
              "报告",
              "实战方法",
              "观点专访"
            ]
          }
        },
        "channels_l1": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "channels_l2": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "companies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "products": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
