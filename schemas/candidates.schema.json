{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/candidates.schema.json",
  "title": "AI Daily Candidate Pool",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_date", "generated_at", "sources", "candidates"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "default": []
    }
  },
  "$defs": {
    "absolute_url": {
      "type": "string",
      "format": "uri"
    },
    "editorial_category": {
      "enum": [
        "headline",
        "ai_industry",
        "engineering_toolchain",
        "model_release",
        "company_business",
        "policy_infra",
        "content_aigc",
        "product_radar",
        "funding",
        "open_source",
        "viewpoint_analysis",
        "podcast",
        "x_discussion",
        "community_signal"
      ]
    },
    "source_level": {
      "enum": [
        "primary",
        "official",
        "paper",
        "github",
        "multi_source",
        "intermediary",
        "community",
        "original_social",
        "unverified",
        "wechat_primary_like",
        "wechat_industry_whitelist",
        "weekly_paper_aggregator",
        "open_source_aggregator",
        "tech_weekly_aggregator",
        "paper_api",
        "community_api",
        "paper_aggregator",
        "ai_news_aggregator",
        "aigc_content_industry",
        "ai_funding_product_radar",
        "official_company_news",
        "official_open_source_account",
        "official_model_host_account",
        "model_registry",
        "platform_exempt_signal"
      ]
    },
    "verification_status": {
      "enum": [
        "primary_confirmed",
        "multi_source_confirmed",
        "intermediary_only",
        "original_social_only",
        "unverified",
        "platform_exempt_unverified"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "category", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "category": {
          "enum": ["official_release", "github_trending", "huggingface_trending", "builder", "blog", "project", "community", "model_registry", "repository", "other"]
        },
        "status": {
          "enum": ["checked", "blocked", "no_signal"]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        },
        "intermediary_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "primary_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "original_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "editorial_category": {
          "$ref": "#/$defs/editorial_category"
        },
        "source_level": {
          "$ref": "#/$defs/source_level"
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        },
        "risk_note": {
          "type": "string",
          "minLength": 1
        },
        "reader_relevance": {
          "type": "string",
          "minLength": 1
        },
        "verification_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolute_url"
          },
          "default": []
        },
        "signal": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "language": {
          "type": "string"
        },
        "window": {
          "type": "string"
        },
        "rank": {
          "type": "integer"
        },
        "previous_rank": {
          "type": ["integer", "null"]
        },
        "rank_delta": {
          "type": ["integer", "null"]
        },
        "trend": {
          "enum": ["trending", "new", "up", "down", "same"]
        },
        "platform": {
          "enum": ["wechat", "zhihu", "reddit"]
        },
        "rule_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "category", "title", "url", "source", "event_date", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": ["main_item", "github_trending", "huggingface_trending", "model_release", "hot_blog", "project", "builder_observation", "community_lead", "wechat_item", "zhihu_item", "reddit_item"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": ["included", "excluded"]
        },
        "included_in": {
          "enum": ["main_items", "github_trending", "huggingface_trending", "model_releases", "hot_blogs", "projects", "builder_observations", "community_leads", "wechat_items", "zhihu_items", "reddit_items"]
        },
        "exclusion_reason": {
          "type": "string"
        },
        "main_reject_reason": {
          "type": "string",
          "minLength": 1
        },
        "main_selection_stage": {
          "enum": [
            "strict",
            "refill",
            "refill_github",
            "refill_builder",
            "refill_hot_blog",
            "refill_community",
            "refill_window",
            "refill_weak_signal"
          ]
        },
        "main_story_id": {
          "type": "string",
          "minLength": 1
        },
        "main_story_role": {
          "enum": ["primary", "supporting"]
        },
        "main_story_primary_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "curated_first_party": {
          "type": "boolean"
        },
        "original_text": {
          "type": "string",
          "minLength": 1
        },
        "avatar_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "avatar_local_path": {
          "type": "string",
          "minLength": 1
        },
        "image_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "image_urls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolute_url"
          },
          "default": []
        },
        "image_alt": {
          "type": "string",
          "minLength": 1
        },
        "image_source": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "downloads": {
          "type": "integer",
          "minimum": 0
        },
        "likes": {
          "type": "integer",
          "minimum": 0
        },
        "task": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "notes": {
          "type": "string"
        },
        "intermediary_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "primary_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "original_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "editorial_category": {
          "$ref": "#/$defs/editorial_category"
        },
        "source_level": {
          "$ref": "#/$defs/source_level"
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        },
        "risk_note": {
          "type": "string",
          "minLength": 1
        },
        "reader_relevance": {
          "type": "string",
          "minLength": 1
        },
        "verification_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolute_url"
          },
          "default": []
        },
        "platform": {
          "enum": ["wechat", "zhihu", "reddit"]
        },
        "rule_id": {
          "$ref": "#/$defs/id"
        },
        "claim_text": {
          "type": "string",
          "minLength": 1
        },
        "why_watch": {
          "type": "string",
          "minLength": 1
        },
        "disclosure": {
          "type": "string",
          "minLength": 1
        },
        "matched_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exemption_policy": {
          "enum": ["platform_signal_exempt"]
        },
        "published_by_gate": {
          "enum": ["deterministic_platform_gate"]
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
