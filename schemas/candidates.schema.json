{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jasonxzwen.github.io/ai-daily-cn/schemas/candidates.schema.json",
  "title": "AI Daily Candidate Pool",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_date", "generated_at", "sources", "candidates"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "main_audit_contract_version": {
      "const": 1
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "default": []
    }
  },
  "$defs": {
    "absolute_url": {
      "type": "string",
      "format": "uri"
    },
    "editorial_category": {
      "type": "string",
      "minLength": 1
    },
    "source_level": {
      "type": "string",
      "minLength": 1
    },
    "verification_status": {
      "type": "string",
      "minLength": 1
    },
    "source_watch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal",
        "target_id",
        "source_lane",
        "source_tier",
        "verification_policy",
        "event_url",
        "snapshot_fingerprint"
      ],
      "properties": {
        "signal": {
          "enum": ["github_watch", "site_watch"]
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "source_lane": {
          "type": "string",
          "minLength": 1
        },
        "source_tier": {
          "type": "string",
          "minLength": 1
        },
        "verification_policy": {
          "type": "string",
          "minLength": 1
        },
        "event_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "snapshot_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "repo_snapshot": {
          "$ref": "#/$defs/source_watch_repo_snapshot"
        },
        "site_snapshot": {
          "$ref": "#/$defs/source_watch_site_snapshot"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": ["repo_snapshot"],
          "properties": {
            "signal": { "const": "github_watch" },
            "repo_snapshot": { "$ref": "#/$defs/source_watch_repo_snapshot" },
            "site_snapshot": false
          }
        },
        {
          "type": "object",
          "required": ["site_snapshot"],
          "properties": {
            "signal": { "const": "site_watch" },
            "repo_snapshot": false,
            "site_snapshot": { "$ref": "#/$defs/source_watch_site_snapshot" }
          }
        }
      ]
    },
    "source_watch_repo_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "stars",
        "forks",
        "open_issues",
        "pushed_at",
        "updated_at",
        "default_branch",
        "language",
        "license",
        "latest_release",
        "latest_tag",
        "latest_commit",
        "readme_status"
      ],
      "properties": {
        "repo": { "type": "string", "minLength": 3 },
        "stars": { "type": "integer", "minimum": 0 },
        "forks": { "type": "integer", "minimum": 0 },
        "open_issues": { "type": "integer", "minimum": 0 },
        "pushed_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "default_branch": { "type": "string" },
        "language": { "type": "string" },
        "license": { "type": "string" },
        "latest_release": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["tag_name", "name", "html_url", "published_at", "prerelease"],
          "properties": {
            "tag_name": { "type": "string" },
            "name": { "type": "string" },
            "html_url": { "type": "string" },
            "published_at": { "type": "string" },
            "prerelease": { "type": "boolean" }
          }
        },
        "latest_tag": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["name", "commit_sha"],
          "properties": {
            "name": { "type": "string" },
            "commit_sha": { "type": "string" }
          }
        },
        "latest_commit": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["sha", "html_url", "message", "author_date", "author_name"],
          "properties": {
            "sha": { "type": "string" },
            "html_url": { "type": "string" },
            "message": { "type": "string" },
            "author_date": { "type": "string" },
            "author_name": { "type": "string" }
          }
        },
        "readme_status": {
          "enum": ["checked", "empty", "missing", "blocked", "not_fetched"]
        }
      }
    },
    "source_watch_site_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "canonical_url", "content_fingerprint", "feeds", "discovered_github_repositories"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "canonical_url": { "$ref": "#/$defs/absolute_url" },
        "content_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "feeds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "type", "url"],
            "properties": {
              "title": { "type": "string" },
              "type": { "type": "string" },
              "url": { "$ref": "#/$defs/absolute_url" }
            }
          }
        },
        "discovered_github_repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "url"],
            "properties": {
              "repo": { "type": "string", "minLength": 3 },
              "url": { "$ref": "#/$defs/absolute_url" }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "category", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "category": {
          "enum": ["official_release", "github_trending", "huggingface_trending", "builder", "blog", "project", "community", "model_registry", "repository", "other"]
        },
        "status": {
          "enum": ["checked", "blocked", "no_signal"]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        },
        "intermediary_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "primary_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "original_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "editorial_category": {
          "$ref": "#/$defs/editorial_category"
        },
        "source_level": {
          "$ref": "#/$defs/source_level"
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        },
        "risk_note": {
          "type": "string",
          "minLength": 1
        },
        "reader_relevance": {
          "type": "string",
          "minLength": 1
        },
        "verification_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolute_url"
          },
          "default": []
        },
        "signal": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "language": {
          "type": "string"
        },
        "window": {
          "type": "string"
        },
        "rank": {
          "type": "integer"
        },
        "previous_rank": {
          "type": ["integer", "null"]
        },
        "rank_delta": {
          "type": ["integer", "null"]
        },
        "trend": {
          "enum": ["trending", "new", "up", "down", "same"]
        },
        "platform": {
          "enum": ["wechat", "zhihu", "reddit"]
        },
        "rule_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "category", "title", "url", "source", "event_date", "status"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "observation_id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": ["main_item", "github_trending", "huggingface_trending", "model_release", "hot_blog", "project", "builder_observation", "community_lead", "wechat_item", "zhihu_item", "reddit_item"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/absolute_url"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "event_date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": ["included", "excluded"]
        },
        "included_in": {
          "enum": ["main_items", "github_trending", "huggingface_trending", "model_releases", "hot_blogs", "projects", "builder_observations", "community_leads", "wechat_items", "zhihu_items", "reddit_items", "source_watch"]
        },
        "exclusion_reason": {
          "type": "string"
        },
        "main_reject_reason": {
          "enum": [
            "invalid_candidate",
            "missing_url",
            "missing_reader_visible_title",
            "templated_story_title",
            "future_dated",
            "outside_main_window",
            "recent_duplicate",
            "statuspage",
            "search_shadow",
            "huggingface_trending_lane",
            "unverified_aggregator_lead",
            "primary_required_intermediary_lead",
            "generic_github_trending_text",
            "generic_hot_blog_announcement",
            "public_filler_text",
            "low_value_product_hunt_project",
            "low_value_vendor_availability_pr",
            "low_value",
            "low_value_event_guide",
            "low_value_profile",
            "minor_consumer_ai_feature",
            "low_signal_vendor_partnership",
            "builder_low_signal",
            "hardcore_research_only",
            "community_single_source_story",
            "secondary_single_source_story",
            "not_ai_relevant",
            "thin_candidate_detail",
            "unverified_high_risk_claim",
            "not_main_refill_material",
            "not_selected_lower_priority",
            "retired_platform_lane",
            "not_evaluated_section_item"
          ]
        },
        "main_selection_stage": {
          "enum": [
            "strict",
            "refill",
            "refill_github",
            "refill_builder",
            "refill_hot_blog",
            "refill_community",
            "refill_window",
            "refill_weak_signal"
          ]
        },
        "main_rank_score": {
          "type": "number"
        },
        "main_rank": {
          "type": "integer",
          "minimum": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "main_stream_candidate",
              "github_trending",
              "hot_blog",
              "builder_signal",
              "community_signal",
              "official_update"
            ]
          },
          "uniqueItems": true,
          "default": []
        },
        "window_fill": {
          "type": "boolean"
        },
        "story_key": {
          "type": "string",
          "minLength": 1
        },
        "claim_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "material_update": {
          "type": "boolean"
        },
        "main_story_id": {
          "type": "string",
          "minLength": 1
        },
        "main_story_role": {
          "enum": ["primary", "supporting"]
        },
        "main_story_primary_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_group": {
          "type": "string",
          "minLength": 1
        },
        "content_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "curated_first_party": {
          "type": "boolean"
        },
        "original_text": {
          "type": "string",
          "minLength": 1
        },
        "avatar_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "avatar_local_path": {
          "type": "string",
          "minLength": 1
        },
        "image_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "image_urls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolute_url"
          },
          "default": []
        },
        "image_alt": {
          "type": "string",
          "minLength": 1
        },
        "image_source": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "downloads": {
          "type": "integer",
          "minimum": 0
        },
        "likes": {
          "type": "integer",
          "minimum": 0
        },
        "task": {
          "type": "string"
        },
        "repository_language": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "notes": {
          "type": "string"
        },
        "intermediary_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "primary_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "original_url": {
          "$ref": "#/$defs/absolute_url"
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "editorial_category": {
          "$ref": "#/$defs/editorial_category"
        },
        "source_level": {
          "$ref": "#/$defs/source_level"
        },
        "verification_note": {
          "type": "string",
          "minLength": 1
        },
        "risk_note": {
          "type": "string",
          "minLength": 1
        },
        "reader_relevance": {
          "type": "string",
          "minLength": 1
        },
        "verification_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolute_url"
          },
          "default": []
        },
        "platform": {
          "enum": ["wechat", "zhihu", "reddit"]
        },
        "rule_id": {
          "$ref": "#/$defs/id"
        },
        "claim_text": {
          "type": "string",
          "minLength": 1
        },
        "why_watch": {
          "type": "string",
          "minLength": 1
        },
        "disclosure": {
          "type": "string",
          "minLength": 1
        },
        "matched_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exemption_policy": {
          "enum": ["platform_signal_exempt"]
        },
        "published_by_gate": {
          "enum": ["deterministic_platform_gate"]
        },
        "source_watch": {
          "$ref": "#/$defs/source_watch"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["included_in"],
            "properties": {
              "included_in": { "const": "source_watch" }
            }
          },
          "then": {
            "type": "object",
            "required": ["source_watch"],
            "properties": {
              "source_watch": { "$ref": "#/$defs/source_watch" }
            }
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
