{
  "schema_version": 1,
  "name": "codex-native-daily-pipeline",
  "daily_runner": {
    "script": "daily:codex-pipeline",
    "legacy_script": "daily:run",
    "launcher_only": true,
    "summary_path_template": ".tmp/run-summary-YYYY-MM-DD.json",
    "source_watch": {
      "producer_stage": "discover_source_watch",
      "producer_artifact_path_template": ".tmp/source-watch-YYYY-MM-DD.json",
      "draft_stage": "report_draft",
      "persistence_stage": "report_write",
      "candidate_pool_path_template": "reports-data/internal/candidates/YYYY/MM/YYYY-MM-DD.candidates.json",
      "consumer_stage": "build",
      "build_consumption_field": "source_watch_consumption",
      "connected_requires": [
        "producer_stage_receipt_path_and_sha256_match",
        "draft_and_report_write_passed",
        "producer_and_candidate_pool_snapshot_sets_equal",
        "same_day_candidate_pool_exists",
        "build_stage_passed",
        "candidate_pool_path_consumed",
        "candidate_pool_sha256_matches"
      ],
      "zero_included_candidates_still_consumed": true
    },
    "official_blog_context": {
      "producer_stage": "official_blog_context",
      "source_artifact_path_template": ".tmp/content-sources-YYYY-MM-DD.json",
      "context_artifact_path_template": ".tmp/official-blog-context-YYYY-MM-DD.json",
      "consumer_stage": "report_draft",
      "persistence_stage": "report_write",
      "admission_policy_version": "official-blog-admission-v1",
      "consumed_requires": [
        "matching_report_date",
        "source_artifact_report_date_matches",
        "source_artifact_sha256_matches",
        "context_sha256_matches",
        "bindings_sha256_matches",
        "bindings_match_context_records_and_source_entries",
        "context_visibility_internal",
        "highest_score_content_type_binding_wins"
      ],
      "zero_matched_records_still_consumed": true,
      "invalid_context_degrades_without_consumption": true
    },
    "modes": {
      "dry_run": {
        "publish_allowed": false,
        "terminal_status": "generated_only"
      },
      "publish": {
        "publish_allowed": true,
        "terminal_status": "published"
      }
    },
    "scheduled_dry_run_script": "publish:dry-run:daily"
  },
  "status_self_check": {
    "script": "status:self-check",
    "scheduled": false,
    "mode": "manual_diagnostic_only",
    "truth_source": ".tmp/run-summary-YYYY-MM-DD.json",
    "summary_path_template": ".tmp/status-self-check-YYYY-MM-DD.json",
    "blocking_issue": "multiple_active_daily_publish_automations"
  },
  "required_package_scripts": {
    "daily:codex-pipeline": "node scripts/run-daily-codex-pipeline.mjs",
    "daily:codex-dag:contract-run": "node scripts/run-daily-codex-dag.mjs --contract-run --json",
    "daily:run": "node src/cli.js daily:run",
    "status:self-check": "node src/cli.js status:self-check --data-input reports-data --input reports-source --out docs",
    "workflow:validate": "node scripts/validate-daily-workflow-contract.mjs",
    "resilience:validate": "node scripts/validate-daily-resilience-policy.mjs",
    "dag:validate": "node scripts/validate-daily-codex-dag.mjs",
    "publish:dry-run:daily": "node src/cli.js publish:dry-run:daily --data-input reports-data --input reports-source --out docs"
  },
  "validate_must_include": [
    "pnpm run dag:validate",
    "pnpm run workflow:validate",
    "pnpm run resilience:validate"
  ],
  "required_markers": [
    {
      "path": "tasks/daily-publish-runbook.md",
      "contains": [
        "corepack pnpm run daily:codex-pipeline",
        "--execute",
        "--publish",
        "completed_stages",
        "publish:dry-run:daily",
        ".tmp/run-summary-YYYY-MM-DD.json",
        "source_watch.production_status",
        "source_watch.connected",
        "source_watch.consumed",
        "candidate_pool_hashes",
        "reports-data/internal/candidates/YYYY/MM/YYYY-MM-DD.candidates.json",
        "sources:phase5-audit",
        "status:self-check",
        "config/daily-resilience-policy.json",
        "corepack pnpm run resilience:validate",
        "published_degraded",
        "infrastructure_blocked_after_fallback_exhausted",
        "multiple_active_daily_publish_automations"
      ]
    },
    {
      "path": "prompts/ai-daily/modules/publish-workflow.md",
      "contains": [
        "corepack pnpm run daily:codex-pipeline",
        "--execute",
        "--publish",
        "completed_stages",
        ".tmp/daily-codex-pipeline/YYYY-MM-DD",
        "publish:dry-run:daily",
        "sources:phase5-audit",
        "status:self-check",
        "config/daily-resilience-policy.json",
        "corepack pnpm run resilience:validate",
        "published_degraded",
        "infrastructure_blocked_after_fallback_exhausted",
        ".tmp/run-summary-YYYY-MM-DD.json",
        "source_watch.production_status",
        "source_watch.connected",
        "source_watch.consumed",
        "candidate_pool_hashes",
        "reports-data/internal/candidates/YYYY/MM/YYYY-MM-DD.candidates.json",
        "next_action",
        "Codex-native runner"
      ]
    },
    {
      "path": "docs/codex-automation-setup.md",
      "contains": [
        "corepack pnpm run daily:codex-pipeline",
        "--execute",
        "--publish",
        "completed_stages",
        ".tmp/daily-codex-pipeline/YYYY-MM-DD",
        "publish:dry-run:daily",
        "sources:phase5-audit",
        "status:self-check",
        "config/daily-resilience-policy.json",
        "corepack pnpm run resilience:validate",
        "published_degraded",
        "infrastructure_blocked_after_fallback_exhausted",
        "multiple_active_daily_publish_automations",
        ".tmp/run-summary-YYYY-MM-DD.json",
        "source_watch.production_status",
        "source_watch.connected",
        "source_watch.consumed",
        "candidate_pool_hashes",
        "reports-data/internal/candidates/YYYY/MM/YYYY-MM-DD.candidates.json",
        "next_action"
      ]
    },
    {
      "path": "tasks/templates/daily-publish-task.md",
      "contains": [
        "corepack pnpm run daily:codex-pipeline",
        "--execute",
        "--publish",
        "completed_stages",
        ".tmp/daily-codex-pipeline/YYYY-MM-DD",
        "publish:dry-run:daily",
        "sources:phase5-audit",
        "status:self-check",
        "config/daily-resilience-policy.json",
        "corepack pnpm run resilience:validate",
        "published_degraded",
        "infrastructure_blocked_after_fallback_exhausted",
        ".tmp/run-summary-YYYY-MM-DD.json",
        "source_watch.production_status",
        "source_watch.connected",
        "source_watch.consumed",
        "candidate_pool_hashes",
        "reports-data/internal/candidates/YYYY/MM/YYYY-MM-DD.candidates.json"
      ]
    }
  ],
  "forbidden_markers": [
    {
      "path": "docs/codex-automation-setup.md",
      "not_contains": [
        "source_reset_preflight",
        "codex_ai_repair_contract",
        "--source-watch-admitted-artifact"
      ]
    },
    {
      "path": "tasks/daily-publish-runbook.md",
      "not_contains": [
        "source_reset_preflight",
        "codex_ai_repair_contract",
        "--source-watch-admitted-artifact"
      ]
    },
    {
      "path": "tasks/templates/daily-publish-task.md",
      "not_contains": [
        "source_reset_preflight",
        "codex_ai_repair_contract",
        "--source-watch-admitted-artifact"
      ]
    },
    {
      "path": "prompts/ai-daily/modules/publish-workflow.md",
      "not_contains": [
        "--source-watch-admitted-artifact"
      ]
    }
  ],
  "external_automation_prompt": {
    "target": "active_daily_publish",
    "contains": [
      "corepack pnpm run daily:codex-pipeline",
      "--execute",
      "--publish",
      ".tmp/run-summary-YYYY-MM-DD.json",
      "completed_stages",
      "automation_pipeline_mode",
      "publish:dry-run:daily",
      "bootstrap mainSha",
      "不要另行运行 status:self-check",
      "Get-Content -LiteralPath $summaryPath -Raw -Encoding UTF8",
      "source_watch.connected",
      "source_watch.consumed",
      "candidate_pool_hashes"
    ],
    "not_contains": [
      "publish:prepare-worktree",
      "corepack pnpm run publish:dry-run --",
      "pnpm run publish:dry-run --",
      "--source-watch-admitted-artifact",
      "not_connected",
      "source_watch.consumed 必须是 false"
    ]
  },
  "external_automation_inventory": {
    "require_single_project_automation": true,
    "require_single_active_publish": true,
    "project_cwds": [
      "D:\\ai-daily-cn"
    ],
    "allowed_project_automation_ids": [
      "ai-2"
    ],
    "allowed_daily_publish_ids": [
      "ai-2"
    ],
    "require_active_status_self_check": false
  }
}
