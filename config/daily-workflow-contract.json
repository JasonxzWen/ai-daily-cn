{
  "schema_version": 1,
  "name": "codex-native-daily-pipeline",
  "daily_runner": {
    "script": "daily:codex-pipeline",
    "legacy_script": "daily:run",
    "launcher_only": true,
    "summary_path_template": ".tmp/run-summary-YYYY-MM-DD.json",
    "public_signals": {
      "content_admission_gate": false,
      "membership_policy": "all_safe_normalized_observations",
      "labels_are_non_gating": [
        "source_group",
        "content_tags",
        "credibility_tag",
        "source_health",
        "access_state"
      ],
      "discovery_lanes": [
        {
          "id": "github-trending",
          "stage_id": "discover_github_trending",
          "artifact_path_template": ".tmp/github-trending-YYYY-MM-DD.json"
        },
        {
          "id": "source-watch",
          "stage_id": "discover_source_watch",
          "artifact_path_template": ".tmp/source-watch-YYYY-MM-DD.json"
        },
        {
          "id": "huggingface-trending",
          "stage_id": "discover_huggingface_trending",
          "artifact_path_template": ".tmp/huggingface-trending-YYYY-MM-DD.json"
        },
        {
          "id": "builders",
          "stage_id": "discover_builders",
          "artifact_path_template": ".tmp/builders-YYYY-MM-DD.json"
        },
        {
          "id": "china-ai",
          "stage_id": "discover_china_ai",
          "artifact_path_template": ".tmp/china-ai-YYYY-MM-DD.json"
        },
        {
          "id": "content-sources",
          "stage_id": "discover_content_sources",
          "artifact_path_template": ".tmp/content-sources-YYYY-MM-DD.json"
        },
        {
          "id": "statuspage-incidents",
          "stage_id": "discover_statuspage_incidents",
          "artifact_path_template": ".tmp/statuspage-incidents-YYYY-MM-DD.json"
        },
        {
          "id": "search-news",
          "stage_id": "discover_search_news",
          "artifact_path_template": ".tmp/search-news-YYYY-MM-DD.json"
        }
      ],
      "publishes_before_legacy_report": true,
      "history_baseline": {
        "path_pattern": "reports-data/occurrences/baseline-v1/YYYY-MM.json.gz",
        "manifest_path": "reports-data/occurrence-baseline-manifest.json",
        "immutable": true,
        "production_reads_legacy_artifacts": false,
        "migration_script": "signals:migrate-baseline"
      },
      "source_watch": {
        "producer_stage": "discover_source_watch",
        "producer_artifact_path_template": ".tmp/source-watch-YYYY-MM-DD.json",
        "persistence_stage": "signals_write",
        "occurrence_store_path_template": "reports-data/occurrences/YYYY/MM/YYYY-MM-DD.json",
        "consumer_stage": "signals_build",
        "validation_stage": "signals_validate",
        "public_index_path": "docs/signals/index.json",
        "connected_requires": [
          "producer_stage_receipt_path_and_sha256_match",
          "signals_write_passed",
          "same_day_occurrence_store_schema_valid",
          "producer_snapshots_trace_to_occurrence_observation_ids",
          "signals_build_passed",
          "signals_validate_passed",
          "public_signal_index_schema_valid"
        ],
        "zero_observations_still_consumed": true
      }
    },
    "curated_source_shadow": {
      "stage_id": "curated_source_shadow",
      "script": "sources:curated-shadow",
      "scope": "internal_shadow",
      "runs_after": "discover_search_news",
      "runs_before": "signal_pool_shadow",
      "public_behavior_changes": false,
      "failure_blocks_legacy_publisher": false,
      "raw_observations_path_template": "reports-data/observations/YYYY/MM/YYYY-MM-DD.json",
      "source_funnel_path_template": "reports-data/source-funnel/YYYY/MM/YYYY-MM-DD.json",
      "signal_publish_companion": "optional_same_day",
      "phase_1a_terminal_stages": {
        "registered": "run",
        "fetched": "run",
        "parsed": "run",
        "admitted": "not_run",
        "displayed": "not_run"
      },
      "aify_receipts": [
        "aify_today_picks",
        "site-aify-news"
      ],
      "active_aify_archive_unchanged": true
    },
    "signal_pool_shadow": {
      "stage_id": "signal_pool_shadow",
      "script": "signals:pool-shadow",
      "scope": "internal_shadow",
      "runs_after": "curated_source_shadow",
      "runs_before": "signals_write",
      "public_behavior_changes": false,
      "failure_blocks_legacy_publisher": false,
      "signal_pool_path_template": "reports-data/signals/YYYY/MM/YYYY-MM-DD.json",
      "public_ready_path_template": "reports-data/public-signal-pool/YYYY/MM/YYYY-MM-DD.json",
      "summary_readiness_fail_closed": true,
      "aify_today_picks_passthrough": true
    },
    "legacy_report": {
      "optional_derivative": true,
      "cannot_change_signal_membership": true,
      "runs_after_public_signal_publish": true,
      "official_blog_context": {
        "scope": "legacy_report_only",
        "producer_stage": "official_blog_context",
        "source_artifact_path_template": ".tmp/content-sources-YYYY-MM-DD.json",
        "context_artifact_path_template": ".tmp/official-blog-context-YYYY-MM-DD.json",
        "consumer_stage": "report_draft",
        "persistence_stage": "report_write",
        "admission_policy_version": "official-blog-admission-v1",
        "consumed_requires": [
          "matching_report_date",
          "source_artifact_report_date_matches",
          "source_artifact_sha256_matches",
          "context_sha256_matches",
          "bindings_sha256_matches",
          "bindings_match_context_records_and_source_entries",
          "context_visibility_internal",
          "highest_score_content_type_binding_wins"
        ],
        "zero_matched_records_still_consumed": true,
        "invalid_context_degrades_without_consumption": true
      }
    },
    "modes": {
      "dry_run": {
        "publish_allowed": false,
        "allowed_terminal_statuses": [
          "generated_only",
          "generated_degraded",
          "generated_signals_only"
        ]
      },
      "publish": {
        "publish_allowed": true,
        "allowed_terminal_statuses": [
          "published",
          "published_signals_only",
          "published_pending_pages_verification"
        ]
      }
    },
    "scheduled_dry_run_script": "publish:dry-run:daily"
  },
  "status_self_check": {
    "script": "status:self-check",
    "scheduled": false,
    "mode": "manual_diagnostic_only",
    "truth_source": ".tmp/run-summary-YYYY-MM-DD.json",
    "summary_path_template": ".tmp/status-self-check-YYYY-MM-DD.json",
    "blocking_issue": "multiple_active_daily_publish_automations"
  },
  "required_package_scripts": {
    "daily:codex-pipeline": "node scripts/run-daily-codex-pipeline.mjs",
    "daily:codex-dag:contract-run": "node scripts/run-daily-codex-dag.mjs --contract-run --json",
    "daily:run": "node src/cli.js daily:run",
    "signals:write": "node src/cli.js signals:write",
    "signals:pool-shadow": "node src/cli.js signals:pool-shadow",
    "signals:migrate-baseline": "node scripts/migrate-public-signal-baseline.mjs",
    "signals:build": "node src/cli.js signals:build --data-input reports-data --out docs",
    "signals:validate": "node src/cli.js signals:validate --out docs",
    "sources:curated-shadow": "node src/cli.js sources:curated-shadow",
    "status:self-check": "node src/cli.js status:self-check --data-input reports-data --input reports-source --out docs",
    "workflow:validate": "node scripts/validate-daily-workflow-contract.mjs",
    "resilience:validate": "node scripts/validate-daily-resilience-policy.mjs",
    "dag:validate": "node scripts/validate-daily-codex-dag.mjs",
    "publish:dry-run:daily": "node src/cli.js publish:dry-run:daily --data-input reports-data --input reports-source --out docs",
    "publish:dry-run:signals": "node src/cli.js publish:dry-run:signals --data-input reports-data --out docs"
  },
  "validate_must_include": [
    "pnpm run dag:validate",
    "pnpm run workflow:validate",
    "pnpm run resilience:validate"
  ],
  "required_markers": [
    {
      "path": "tasks/daily-publish-runbook.md",
      "contains": [
        "corepack pnpm run daily:codex-pipeline",
        "--execute",
        "--publish",
        "completed_stages",
        "publish:dry-run:daily",
        ".tmp/run-summary-YYYY-MM-DD.json",
        "signals_write",
        "signals_build",
        "signals_validate",
        "signals_publish_dry_run",
        "signals_publish_real",
        "signals.status",
        "legacy_report.status",
        "source_watch.production_status",
        "source_watch.connected",
        "source_watch.consumed",
        "reports-data/occurrences/YYYY/MM/YYYY-MM-DD.json",
        "reports-data/occurrences/baseline-v1",
        "reports-data/occurrence-baseline-manifest.json",
        "signals:migrate-baseline",
        "docs/signals/index.json",
        "generated_signals_only",
        "published_signals_only",
        "sources:phase5-audit",
        "status:self-check",
        "config/daily-resilience-policy.json",
        "corepack pnpm run resilience:validate",
        "published_degraded",
        "infrastructure_blocked_after_fallback_exhausted",
        "multiple_active_daily_publish_automations",
        "next_action"
      ]
    },
    {
      "path": "prompts/ai-daily/modules/publish-workflow.md",
      "contains": [
        "corepack pnpm run daily:codex-pipeline",
        "--execute",
        "--publish",
        "completed_stages",
        ".tmp/daily-codex-pipeline/YYYY-MM-DD",
        "publish:dry-run:daily",
        "signals_write",
        "signals_build",
        "signals_validate",
        "signals_publish_dry_run",
        "signals_publish_real",
        "signals.status",
        "legacy_report.status",
        "source_watch.production_status",
        "source_watch.connected",
        "source_watch.consumed",
        "reports-data/occurrences/YYYY/MM/YYYY-MM-DD.json",
        "reports-data/occurrences/baseline-v1",
        "reports-data/occurrence-baseline-manifest.json",
        "signals:migrate-baseline",
        "docs/signals/index.json",
        "generated_signals_only",
        "published_signals_only",
        "sources:phase5-audit",
        "status:self-check",
        "config/daily-resilience-policy.json",
        "corepack pnpm run resilience:validate",
        "published_degraded",
        "infrastructure_blocked_after_fallback_exhausted",
        ".tmp/run-summary-YYYY-MM-DD.json",
        "next_action",
        "Codex-native runner"
      ]
    },
    {
      "path": "docs/codex-automation-setup.md",
      "contains": [
        "corepack pnpm run daily:codex-pipeline",
        "--execute",
        "--publish",
        "completed_stages",
        ".tmp/daily-codex-pipeline/YYYY-MM-DD",
        "publish:dry-run:daily",
        "signals_write",
        "signals_build",
        "signals_validate",
        "signals_publish_dry_run",
        "signals_publish_real",
        "signals.status",
        "legacy_report.status",
        "source_watch.production_status",
        "source_watch.connected",
        "source_watch.consumed",
        "reports-data/occurrences/YYYY/MM/YYYY-MM-DD.json",
        "reports-data/occurrences/baseline-v1",
        "reports-data/occurrence-baseline-manifest.json",
        "signals:migrate-baseline",
        "docs/signals/index.json",
        "generated_signals_only",
        "published_signals_only",
        "sources:phase5-audit",
        "status:self-check",
        "config/daily-resilience-policy.json",
        "corepack pnpm run resilience:validate",
        "published_degraded",
        "infrastructure_blocked_after_fallback_exhausted",
        "multiple_active_daily_publish_automations",
        ".tmp/run-summary-YYYY-MM-DD.json",
        "next_action"
      ]
    },
    {
      "path": "tasks/templates/daily-publish-task.md",
      "contains": [
        "corepack pnpm run daily:codex-pipeline",
        "--execute",
        "--publish",
        "completed_stages",
        ".tmp/daily-codex-pipeline/YYYY-MM-DD",
        "publish:dry-run:daily",
        "signals_write",
        "signals_build",
        "signals_validate",
        "signals_publish_dry_run",
        "signals_publish_real",
        "signals.status",
        "legacy_report.status",
        "source_watch.production_status",
        "source_watch.connected",
        "source_watch.consumed",
        "reports-data/occurrences/YYYY/MM/YYYY-MM-DD.json",
        "reports-data/occurrences/baseline-v1",
        "reports-data/occurrence-baseline-manifest.json",
        "docs/signals/index.json",
        "generated_signals_only",
        "published_signals_only",
        "sources:phase5-audit",
        "status:self-check",
        "config/daily-resilience-policy.json",
        "corepack pnpm run resilience:validate",
        "published_degraded",
        "infrastructure_blocked_after_fallback_exhausted",
        ".tmp/run-summary-YYYY-MM-DD.json",
        "next_action"
      ]
    }
  ],
  "forbidden_markers": [
    {
      "path": "docs/codex-automation-setup.md",
      "not_contains": [
        "source_reset_preflight",
        "codex_ai_repair_contract",
        "--source-watch-admitted-artifact",
        "candidate_pool_hashes",
        "reports-data/internal/candidates/YYYY/MM/YYYY-MM-DD.candidates.json",
        "discover_source_watch -> report_draft",
        "--per-source-limit"
      ]
    },
    {
      "path": "tasks/daily-publish-runbook.md",
      "not_contains": [
        "source_reset_preflight",
        "codex_ai_repair_contract",
        "--source-watch-admitted-artifact",
        "candidate_pool_hashes",
        "reports-data/internal/candidates/YYYY/MM/YYYY-MM-DD.candidates.json",
        "discover_source_watch -> report_draft",
        "--per-source-limit"
      ]
    },
    {
      "path": "tasks/templates/daily-publish-task.md",
      "not_contains": [
        "source_reset_preflight",
        "codex_ai_repair_contract",
        "--source-watch-admitted-artifact",
        "candidate_pool_hashes",
        "reports-data/internal/candidates/YYYY/MM/YYYY-MM-DD.candidates.json",
        "discover_source_watch -> report_draft",
        "--per-source-limit"
      ]
    },
    {
      "path": "prompts/ai-daily/modules/publish-workflow.md",
      "not_contains": [
        "--source-watch-admitted-artifact",
        "candidate_pool_hashes",
        "reports-data/internal/candidates/YYYY/MM/YYYY-MM-DD.candidates.json",
        "discover_source_watch -> report_draft",
        "--per-source-limit"
      ]
    }
  ],
  "external_automation_prompt": {
    "target": "active_daily_publish",
    "contains": [
      "corepack pnpm run daily:codex-pipeline",
      "--execute",
      "--publish",
      ".tmp/run-summary-YYYY-MM-DD.json",
      "completed_stages",
      "automation_pipeline_mode",
      "publish:dry-run:daily",
      "bootstrap mainSha",
      "不要另行运行 status:self-check",
      "Get-Content -LiteralPath $summaryPath -Raw -Encoding UTF8",
      "source_watch.connected",
      "source_watch.consumed",
      "occurrence_store_path",
      "signal_index_path",
      "signals.status",
      "legacy_report.status",
      "generated_signals_only",
      "published_signals_only"
    ],
    "not_contains": [
      "publish:prepare-worktree",
      "corepack pnpm run publish:dry-run --",
      "pnpm run publish:dry-run --",
      "--source-watch-admitted-artifact",
      "candidate_pool_hashes",
      "reports-data/internal/candidates",
      "source_watch.production_status must stay not_connected",
      "source_watch.consumed 必须是 false"
    ]
  },
  "external_automation_inventory": {
    "require_single_project_automation": true,
    "require_single_active_publish": true,
    "project_cwds": [
      "D:\\ai-daily-cn"
    ],
    "allowed_project_automation_ids": [
      "ai-2"
    ],
    "allowed_daily_publish_ids": [
      "ai-2"
    ],
    "require_active_status_self_check": false
  }
}
