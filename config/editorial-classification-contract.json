      "official_technical_signal",
      "major_company_priority",
      "model_or_platform_increment",
      "engineering_practice_value",
      "unconfirmed_high_signal_disclosed",
      "watch_source_high_value",
      "github_repo_context_sufficient",
      "trend_hot_or_active"
    ],
    "demotion": [
      "github_readme_context_insufficient",
      "momentum_only",
      "partnership_only",
      "customer_case_low_information",
      "ordinary_rss_repost",
      "low_evidence_single_source",
      "high_noise_x",
      "stale_duplicate",
      "public_internal_boundary_leak",
      "unconfirmed_signal_missing_public_disclosure",
      "unconfirmed_signal_factualized"
    ]
  },
  "admission_targets": {
    "today_selected": {
      "max_items": 20,
      "quota_policy": "upper_bound_not_quota",
      "forbidden_demotion_codes": [
        "github_readme_context_insufficient",
        "momentum_only",
        "partnership_only",
        "customer_case_low_information",
        "ordinary_rss_repost",
        "low_evidence_single_source",
        "high_noise_x",
        "stale_duplicate",
        "public_internal_boundary_leak",
        "unconfirmed_signal_missing_public_disclosure",
        "unconfirmed_signal_factualized"
      ]
    },
    "must_read": {
      "max_items": 8,
      "quota_policy": "upper_bound_not_quota",
      "threshold": "higher_than_today_selected",
      "forbidden_demotion_codes": [
        "github_readme_context_insufficient",
        "momentum_only",
        "partnership_only",
        "customer_case_low_information",
        "ordinary_rss_repost",
        "low_evidence_single_source",
        "high_noise_x",
        "stale_duplicate",
        "public_internal_boundary_leak",
        "unconfirmed_signal_missing_public_disclosure",
        "unconfirmed_signal_factualized"
      ]
    }
  },
  "github_policy": {
    "context_states": ["readme_sufficient", "readme_missing", "readme_insufficient", "readme_fetch_failed"],
    "readme_insufficient": {
      "github_tab_allowed": true,
      "today_selected_allowed": false,
      "must_read_allowed": false,
      "public_summary_mode": "momentum_only",
      "capability_summary_allowed": false
    }
  },
  "watch_source_policy": {
    "internal_retention": "full",
    "public_surface": "digest_list_entry",
    "missing_public_display_means_lost": false
  },
  "trend_policy": {
    "public_states": ["hot", "active"],
    "internal_states": ["hot", "active", "watching", "candidate"]
  },
  "public_private_boundary": {
    "public_articles_forbidden_fields": [
      "editorial_rank",
      "rank_policy",
      "selection_reasons",
      "demotion_reasons"
    ],
    "internal_artifact_required_fields": [
      "editorial_rank",
      "rank_policy",
      "selection_reasons",
      "demotion_reasons"
    ]
  }
