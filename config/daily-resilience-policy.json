      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "none", "action": "block_on_invalid_source_config" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["publish_plan_violation", "unrecoverable_schema"] },
      "summary_fields": ["stage_id", "status", "attempts", "checked_files", "error_code"],
      "replay_fixtures": ["daily-runner-sources-validate"]
    },
    {
      "id": "signals_write",
      "scope": "public_signals",
      "description": "Persist every safely normalized discovery occurrence before any legacy editorial selection.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
