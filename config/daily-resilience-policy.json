      "fallback": { "kind": "bootstrap_latest_main", "action": "prepare_dedicated_publish_checkout" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["publish_plan_violation", "infrastructure_exhausted"] },
      "summary_fields": ["stage_id", "status", "attempts", "remote_main_sha", "clean_repo_root", "error_code"],
      "replay_fixtures": ["daily-runner-clean-worktree"]
    },
    {
      "id": "prompt_build",
      "scope": "shared_preflight",
      "description": "Build the dated generation prompt from committed prompt modules.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "none", "action": "block_on_prompt_contract_error" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["publish_plan_violation", "internal_leakage"] },
