    },
    {
      "id": "validate",
      "description": "Run repository validation before any publish attempt.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "none", "action": "block_on_validation_failure" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["publish_plan_violation", "unrecoverable_schema", "unrecoverable_rendering", "internal_leakage"] },
