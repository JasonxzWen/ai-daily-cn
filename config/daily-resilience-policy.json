      "fallback": { "kind": "none", "action": "block_on_unrenderable_public_artifact" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["unrecoverable_rendering", "internal_leakage"] },
      "summary_fields": ["stage_id", "status", "attempts", "html_path", "json_path", "error_code"],
      "replay_fixtures": ["build-render-error"]
    },
    {
      "id": "quality_page_check",
      "description": "Check rendered public pages for content, layout, media, and theme regressions.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "none", "action": "block_on_public_page_quality_failure" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["unrecoverable_rendering", "internal_leakage", "fake_tracking_component", "unsafe_public_content"] },
      "summary_fields": ["stage_id", "status", "attempts", "page_check_path", "blocking_count", "degraded_count"],
