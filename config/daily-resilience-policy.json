{
  "schema_version": 1,
  "name": "daily-resilience-contract",
  "description": "Recoverability-first policy table for the Codex-native daily publishing workflow.",
  "terminal_statuses": [
    "published",
    "published_degraded",
    "published_pending_pages_verification",
    "generated_only",
    "generated_degraded",
    "generated_signals_only",
    "published_signals_only",
    "needs_ai_repair",
    "unsafe_blocked",
    "infrastructure_blocked_after_fallback_exhausted",
    "blocked"
  ],
  "blocking_whitelist": [
    "unsafe_public_content",
    "unrecoverable_schema",
    "unrecoverable_rendering",
    "internal_leakage",
    "fake_tracking_component",
    "high_risk_unverified_fact",
    "publish_plan_violation",
    "remote_ahead",
    "infrastructure_exhausted"
  ],
  "required_workflow_gates": [
    "pnpm run resilience:validate",
    "pnpm run workflow:validate",
    "pnpm run validate"
  ],
  "stage_defaults": {
    "summary_fields": ["stage_id", "status", "attempts", "duration_ms", "outcome", "error_code"],
    "replay_fixtures": ["daily-runner-stage-summary"]
  },
  "stages": [
    {
      "id": "prepare_clean_worktree",
      "scope": "shared_preflight",
      "description": "Prepare a clean current-origin/main worktree before the daily run.",
