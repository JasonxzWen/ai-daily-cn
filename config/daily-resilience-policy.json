    },
    {
      "id": "retrospective_finalize",
      "description": "Finalize the retrospective as published immediately before real publish.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "none", "action": "block_on_unfinalized_publish_retrospective" },
      "degrade": { "allowed": false, "action": "none" },
