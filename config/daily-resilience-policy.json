{
  "schema_version": 1,
  "name": "daily-resilience-contract",
  "description": "Recoverability-first policy table for the Codex-native daily publishing workflow.",
  "terminal_statuses": [
    "published",
    "published_degraded",
    "published_pending_pages_verification",
    "generated_only",
    "generated_degraded",
    "needs_ai_repair",
    "unsafe_blocked",
    "infrastructure_blocked_after_fallback_exhausted",
    "blocked"
  ],
  "blocking_whitelist": [
    "unsafe_public_content",
    "unrecoverable_schema",
    "unrecoverable_rendering",
    "internal_leakage",
    "fake_tracking_component",
    "high_risk_unverified_fact",
    "publish_plan_violation",
    "remote_ahead",
    "infrastructure_exhausted"
  ],
  "required_workflow_gates": [
    "pnpm run resilience:validate",
    "pnpm run workflow:validate",
    "pnpm run validate"
  ],
  "stage_defaults": {
    "summary_fields": ["stage_id", "status", "attempts", "duration_ms", "outcome", "error_code"],
    "replay_fixtures": ["daily-runner-stage-summary"]
  },
  "stages": [
    {
      "id": "prepare_clean_worktree",
      "description": "Prepare a clean current-origin/main worktree before the daily run.",
      "retry": { "max_attempts": 2, "backoff_ms": [0, 3000], "on": ["git_fetch_timeout", "transient_filesystem_error"] },
      "fallback": { "kind": "bootstrap_latest_main", "action": "prepare_dedicated_publish_checkout" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["publish_plan_violation", "infrastructure_exhausted"] },
      "summary_fields": ["stage_id", "status", "attempts", "remote_main_sha", "clean_repo_root", "error_code"],
      "replay_fixtures": ["daily-runner-clean-worktree"]
    },
    {
      "id": "source_reset_preflight",
      "description": "Fail fast when the checked-out daily code lacks the public-surface source reset contract.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "none", "action": "block_on_stale_or_incomplete_daily_code" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["publish_plan_violation", "internal_leakage"] },
      "summary_fields": ["stage_id", "status", "attempts", "checked_files", "error_code"],
      "replay_fixtures": ["daily-runner-source-reset-preflight"]
    },
    {
      "id": "prompt_build",
      "description": "Build the dated generation prompt from committed prompt modules.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "none", "action": "block_on_prompt_contract_error" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["publish_plan_violation", "internal_leakage"] },
      "summary_fields": ["stage_id", "status", "attempts", "prompt_path", "error_code"],
      "replay_fixtures": ["daily-runner-prompt-build"]
    },
    {
      "id": "sources_validate",
      "description": "Validate source registry configuration before discovery.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "none", "action": "block_on_invalid_source_config" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["publish_plan_violation", "unrecoverable_schema"] },
      "summary_fields": ["stage_id", "status", "attempts", "checked_files", "error_code"],
      "replay_fixtures": ["daily-runner-sources-validate"]
    },
    {
      "id": "discover_github_trending",
      "description": "Collect GitHub Trending candidates from the required weekly language scopes.",
      "retry": { "max_attempts": 3, "backoff_ms": [0, 5000, 15000], "on": ["timeout", "rate_limit", "network_error"] },
      "fallback": { "kind": "cached_or_readme_labeled_candidates", "action": "use_recent_cache_or_label_readme_failure" },
      "degrade": { "allowed": true, "action": "publish_with_degraded_github_trending_lane" },
      "block": { "allowed": true, "reasons": ["unsafe_public_content", "high_risk_unverified_fact"] },
      "summary_fields": ["stage_id", "status", "attempts", "candidate_count", "fallback_used", "degraded_reason"],
      "replay_fixtures": ["github-trending-timeout", "github-trending-readme-fallback"]
    },
    {
      "id": "discover_huggingface_trending",
      "description": "Collect Hugging Face trending model candidates.",
      "retry": { "max_attempts": 3, "backoff_ms": [0, 5000, 15000], "on": ["timeout", "rate_limit", "network_error"] },
      "fallback": { "kind": "cached_candidates", "action": "use_recent_cache_or_empty_degraded_lane" },
      "degrade": { "allowed": true, "action": "publish_with_degraded_huggingface_lane" },
      "block": { "allowed": true, "reasons": ["unsafe_public_content", "high_risk_unverified_fact"] },
      "summary_fields": ["stage_id", "status", "attempts", "candidate_count", "fallback_used", "degraded_reason"],
      "replay_fixtures": ["huggingface-trending-timeout"]
    },
    {
      "id": "discover_builders",
      "description": "Collect AI builder observations from original posts, feeds, and fallback sources.",
      "retry": { "max_attempts": 3, "backoff_ms": [0, 5000, 15000], "on": ["timeout", "rate_limit", "network_error"] },
      "fallback": { "kind": "original_source_backfill", "action": "use_original_status_or_interview_fallbacks" },
      "degrade": { "allowed": true, "action": "publish_with_builder_lane_degraded_note" },
      "block": { "allowed": true, "reasons": ["unsafe_public_content", "high_risk_unverified_fact"] },
      "summary_fields": ["stage_id", "status", "attempts", "candidate_count", "eligible_after_filter", "selected_count", "degraded_reason"],
      "replay_fixtures": ["builders-feed-fetch-failed", "builders-original-source-backfill"]
    },
    {
      "id": "discover_china_ai",
      "description": "Collect China AI source candidates across registered lanes.",
      "retry": { "max_attempts": 3, "backoff_ms": [0, 5000, 15000], "on": ["timeout", "rate_limit", "network_error"] },
      "fallback": { "kind": "per_source_partial_results", "action": "keep_successful_sources_and_mark_failed_sources" },
      "degrade": { "allowed": true, "action": "publish_with_degraded_china_ai_lane" },
      "block": { "allowed": true, "reasons": ["unsafe_public_content", "high_risk_unverified_fact"] },
      "summary_fields": ["stage_id", "status", "attempts", "source_count", "failed_source_count", "degraded_reason"],
      "replay_fixtures": ["china-ai-partial-source-outage"]
    },
    {
      "id": "discover_content_sources",
      "description": "Collect fixed official content source candidates.",
      "retry": { "max_attempts": 3, "backoff_ms": [0, 5000, 15000], "on": ["timeout", "network_error", "feed_parse_error"] },
      "fallback": { "kind": "registered_source_public_backfill", "action": "use_opened_original_pages_or_mark_source_unavailable" },
      "degrade": { "allowed": true, "action": "publish_with_source_outage_disclosure" },
      "block": { "allowed": true, "reasons": ["unsafe_public_content", "high_risk_unverified_fact"] },
      "summary_fields": ["stage_id", "status", "attempts", "checked_source_count", "blocked_source_count", "degraded_reason"],
      "replay_fixtures": ["content-sources-node-fetch-failed"]
    },
    {
      "id": "discover_statuspage_incidents",
      "description": "Collect AI service statuspage incidents.",
      "retry": { "max_attempts": 3, "backoff_ms": [0, 5000, 15000], "on": ["timeout", "network_error"] },
      "fallback": { "kind": "empty_degraded_lane", "action": "publish_without_incident_items_if_source_unavailable" },
      "degrade": { "allowed": true, "action": "mark_statuspage_lane_degraded" },
      "block": { "allowed": true, "reasons": ["high_risk_unverified_fact"] },
      "summary_fields": ["stage_id", "status", "attempts", "incident_count", "degraded_reason"],
      "replay_fixtures": ["statuspage-timeout"]
    },
    {
      "id": "discover_search_news",
      "description": "Collect search/news candidates from configured providers.",
      "retry": { "max_attempts": 3, "backoff_ms": [0, 5000, 15000], "on": ["provider_timeout", "network_error"] },
      "fallback": { "kind": "per_provider_partial_results", "action": "keep_successful_providers_and_label_failed_providers" },
      "degrade": { "allowed": true, "action": "publish_with_degraded_search_lane" },
      "block": { "allowed": true, "reasons": ["unsafe_public_content", "high_risk_unverified_fact"] },
      "summary_fields": ["stage_id", "status", "attempts", "provider_count", "failed_provider_count", "candidate_count"],
      "replay_fixtures": ["search-news-provider-timeout"]
    },
    {
      "id": "sources_health",
      "description": "Run source health checks and expose outages.",
      "retry": { "max_attempts": 2, "backoff_ms": [0, 5000], "on": ["timeout", "network_error"] },
      "fallback": { "kind": "health_from_discovery_audit", "action": "derive_degraded_health_from_discovery_results" },
      "degrade": { "allowed": true, "action": "publish_with_source_health_degraded_status" },
      "block": { "allowed": true, "reasons": ["publish_plan_violation"] },
      "summary_fields": ["stage_id", "status", "attempts", "healthy_count", "blocked_count", "degraded_reason"],
      "replay_fixtures": ["sources-health-network-wide-outage"]
    },
    {
      "id": "report_draft",
      "description": "Generate the structured report draft from discovery inputs.",
      "retry": { "max_attempts": 2, "backoff_ms": [0, 3000], "on": ["transient_io", "candidate_pool_read_error"] },
      "fallback": { "kind": "known_discovery_input_degraded_lane", "action": "replace_missing_known_discovery_input_with_public_degraded_source_audit" },
      "degrade": { "allowed": true, "action": "draft_with_explicit_degraded_source_lanes" },
      "block": { "allowed": true, "reasons": ["unrecoverable_schema", "unsafe_public_content", "high_risk_unverified_fact"] },
      "summary_fields": ["stage_id", "status", "attempts", "candidate_count", "degraded_sections", "error_code"],
      "replay_fixtures": ["report-draft-missing-known-input"]
    },
    {
      "id": "quality_review",
      "description": "Review public text quality and request AI repair when scoped editorial fixes are needed.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "codex_ai_repair_contract", "action": "create_ready_gated_public_text_repair_template" },
      "degrade": { "allowed": true, "action": "continue_after_allowed_public_editorial_repairs" },
      "block": { "allowed": true, "reasons": ["unsafe_public_content", "high_risk_unverified_fact", "internal_leakage"] },
      "summary_fields": ["stage_id", "status", "attempts", "review_path", "ai_review_tasks", "next_action"],
      "replay_fixtures": ["quality-review-public-editorial-repair"]
    },
    {
      "id": "quality_ai_repair",
      "description": "Apply ready-gated AI repair contracts to public text fields only.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "fresh_repair_template", "action": "request_new_contract_when_allowed_edits_are_insufficient" },
      "degrade": { "allowed": true, "action": "publish_after_zero_rejected_public_editorial_repairs" },
      "block": { "allowed": true, "reasons": ["unsafe_public_content", "internal_leakage", "unrecoverable_schema"] },
      "summary_fields": ["stage_id", "status", "attempts", "contract_path", "accepted_edits", "rejected_edits"],
      "replay_fixtures": ["quality-ai-repair-ready-contract", "quality-ai-repair-template-contract"]
    },
    {
      "id": "editorial_rank_artifact",
      "description": "Build the internal editorial rank artifact from the candidate pool before public report write.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "none", "action": "block_on_internal_rank_artifact_error" },
      "degrade": { "allowed": false, "action": "none" },
      "block": { "allowed": true, "reasons": ["publish_plan_violation", "unrecoverable_schema", "internal_leakage"] },
      "summary_fields": ["stage_id", "status", "attempts", "output_path", "item_count", "today_selected_count", "must_read_count", "error_code"],
      "replay_fixtures": ["editorial-rank-artifact-internal"]
    },
    {
      "id": "report_write",
      "description": "Normalize and write the public report JSON.",
      "retry": { "max_attempts": 1, "backoff_ms": [0], "on": [] },
      "fallback": { "kind": "schema_aware_normalizer", "action": "drop_or_normalize_only_allowlisted_public_degraded_fields" },
      "degrade": { "allowed": true, "action": "normalize_public_degraded_fields" },
      "block": { "allowed": true, "reasons": ["unrecoverable_schema", "unsafe_public_content", "fake_tracking_component", "internal_leakage"] },
      "summary_fields": ["stage_id", "status", "attempts", "json_path", "quality_status", "degraded_sections"],
      "replay_fixtures": ["report-write-daily-tracking-source-unavailable"]
    },
