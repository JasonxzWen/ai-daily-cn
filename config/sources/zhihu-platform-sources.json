{
  "schema_version": 1,
  "sources": [
    {
      "id": "platform-zhihu-ai-feed",
      "name": "Zhihu Platform AI Feed",
      "url": "https://example.com/ai-daily-cn/platform/zhihu.xml",
      "source_kind": "rss",
      "candidate_category": "zhihu_item",
      "tier": "T3",
      "authority": "community",
