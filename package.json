{
  "name": "ai-daily-cn-static-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local static publishing infrastructure for Chinese AI daily reports.",
  "scripts": {
    "prompt:build": "node src/cli.js prompt:build",
    "report:draft": "node src/cli.js report:draft",
    "report:write": "node src/cli.js report:write",
    "evidence:cache": "node src/cli.js evidence:cache",
    "quality:review": "node src/cli.js quality:review",
    "quality:repair": "node src/cli.js quality:repair",
    "quality:page-check": "node scripts/check-daily-page.mjs",
    "daily:run": "node src/cli.js daily:run",
    "build": "node src/cli.js build --data-input reports-data --input reports-source --out docs",
    "test": "node --test tests/unit.test.js tests/publish.test.js tests/skills.test.js tests/openspec.test.js",
    "test:e2e": "node scripts/run-e2e.mjs",
    "feedback:validate": "node scripts/validate-feedback-contract.mjs",
    "workflow:validate": "node scripts/validate-daily-workflow-contract.mjs",
    "privacy:validate": "node scripts/scan-public-artifacts.mjs",
    "validate:openspec": "node scripts/validate-openspec.mjs add-ai-daily-static-publishing",
    "validate": "npm run feedback:validate && npm run workflow:validate && npm run sources:validate && npm run test && npm run build && npm run privacy:validate && npm run test:e2e && npm run validate:openspec && git diff --check",
    "publish:prepare-worktree": "node src/cli.js publish:prepare-worktree",
    "publish:prepare-clean-worktree": "node src/cli.js publish:prepare-clean-worktree",
    "publish:preflight": "node src/cli.js publish:preflight",
    "publish:dry-run": "node src/cli.js publish:dry-run --data-input reports-data --input reports-source --out docs",
    "publish:dry-run:daily": "node src/cli.js publish:dry-run:daily --data-input reports-data --input reports-source --out docs",
    "publish:github-api": "node src/cli.js publish:github-api",
    "publish:resume-push": "node src/cli.js publish:resume-push",
    "publish": "node src/cli.js publish",
    "discover:github-trending": "node src/cli.js discover:github-trending",
    "discover:builders": "node src/cli.js discover:builders",
    "discover:content-sources": "node src/cli.js discover:content-sources",
    "discover:search-news": "node src/cli.js discover:search-news",
    "sources:validate": "node src/cli.js sources:validate",
    "sources:health": "node src/cli.js sources:health",
    "sources:audit-merge": "node src/cli.js sources:audit-merge",
    "sources:phase5-audit": "node src/cli.js sources:phase5-audit",
    "discover:statuspage-incidents": "node src/cli.js discover:statuspage-incidents"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "ajv": "^8.17.1"
  },
  "engines": {
    "node": ">=20"
  }
}
